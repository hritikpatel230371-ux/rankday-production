generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Status {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PAUSED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  POSTPONED
  CANCELLED
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  profile       Profile?
  categories    Category[]
  subjects      Subject[]
  activities    Activity[]
  dailyLogs     DailyLog[]
  goals         Goal[]
  tasks         Task[]
  exams         Exam[]
  tests         Test[]
  rankSnapshots RankSnapshot[]
  plannerEntries PlannerEntry[]
  aiInsights    AIInsight[]
  sessions      AuthSession[]
}

model AuthSession {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Profile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  mainGoal           String?
  dailyStudyTargetMin Int     @default(240)
  onboardingComplete Boolean @default(false)
  theme              String   @default("system")
  rankWeights        Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  slug      String
  color     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities Activity[]
  goals     Goal[]
  tasks     Task[]

  @@unique([userId, slug])
  @@index([userId])
}

model Subject {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#38bdf8")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities Activity[]
  goals     Goal[]
  tasks     Task[]
  exams     Exam[]
  units     SyllabusUnit[]
  tests     Test[]

  @@unique([userId, name])
  @@index([userId])
}

model DailyLog {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime
  rawText        String
  summary        Json?
  rankDelta      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities     Activity[]
  tests          Test[]

  @@index([userId, date])
}

model Activity {
  id                String    @id @default(cuid())
  userId            String
  dailyLogId        String?
  categoryId        String?
  subjectId         String?
  title             String
  description       String?
  date              DateTime
  durationMinutes   Int?
  plannedMinutes    Int?
  sentiment         Sentiment @default(NEUTRAL)
  importance        Priority  @default(MEDIUM)
  confidence        Float?
  needsConfirmation Boolean   @default(false)
  confirmed         Boolean   @default(true)
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyLog          DailyLog? @relation(fields: [dailyLogId], references: [id], onDelete: SetNull)
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subject           Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([subjectId])
}

model Goal {
  id           String   @id @default(cuid())
  userId       String
  categoryId   String?
  subjectId    String?
  title        String
  description  String?
  priority     Priority @default(MEDIUM)
  startDate    DateTime?
  dueDate      DateTime?
  progress     Int      @default(0)
  status       Status   @default(NOT_STARTED)
  targetValue  Float?
  currentValue Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subject      Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  tasks        Task[]

  @@index([userId, status])
}

model Task {
  id                String     @id @default(cuid())
  userId            String
  goalId            String?
  categoryId        String?
  subjectId         String?
  title             String
  description       String?
  priority          Priority   @default(MEDIUM)
  dueDate           DateTime?
  estimatedMinutes  Int?
  status            TaskStatus @default(TODO)
  completedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal              Goal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  category          Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subject           Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  plannerEntries    PlannerEntry[]

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([goalId])
}

model Exam {
  id          String   @id @default(cuid())
  userId      String
  subjectId   String?
  name        String
  examDate    DateTime
  totalMarks  Int?
  targetMarks Int?
  priority    Priority @default(HIGH)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, examDate])
  @@index([subjectId])
}

model SyllabusUnit {
  id        String   @id @default(cuid())
  subjectId String
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics    SyllabusTopic[]

  @@index([subjectId])
}

model SyllabusTopic {
  id                    String   @id @default(cuid())
  unitId                String
  name                  String
  estimatedStudyMinutes Int?
  completed             Boolean  @default(false)
  difficulty            Int      @default(3)
  priority              Priority @default(MEDIUM)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  unit                  SyllabusUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
}

model Test {
  id            String   @id @default(cuid())
  userId        String
  subjectId     String?
  dailyLogId    String?
  name          String
  date          DateTime
  obtainedMarks Float
  totalMarks    Float
  percentage    Float
  difficulty    Int      @default(3)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  dailyLog      DailyLog? @relation(fields: [dailyLogId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([subjectId])
}

model RankSnapshot {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime
  score        Int
  delta        Int
  reasons      Json
  components   Json
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model PlannerEntry {
  id               String     @id @default(cuid())
  userId           String
  taskId           String?
  title            String
  period           String
  plannedDate      DateTime
  plannedMinutes   Int?
  completedMinutes Int?
  status           TaskStatus @default(TODO)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  task             Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, plannedDate])
}

model AIInsight {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  content   String
  source    Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
